# GitHub OAuth App credentials
# Create one at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
SESSION_SECRET=your_random_session_secret

# AI Provider (optional — app works without AI, but won't generate summaries)
# Supported: anthropic, openai, google (defaults to anthropic)
# AI_PROVIDER=anthropic

# AI Model (optional — each provider has a sensible default)
# AI_MODEL=claude-haiku-4-5-20251001

# Only the key for your chosen provider is required. Leave these commented
# out to run without AI — a placeholder value would make every summary fail.
# ANTHROPIC_API_KEY=your_anthropic_api_key
# OPENAI_API_KEY=your_openai_api_key
# GOOGLE_AI_API_KEY=your_google_ai_api_key
